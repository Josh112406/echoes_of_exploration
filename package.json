    "references": "tsx tools/build-references.ts",
    "test": "node tools/validate-entries.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}

