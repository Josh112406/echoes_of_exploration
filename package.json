{
  "name": "still-out-there",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Still Out There — Abandoned, but not forgotten. Educational browser game about NASA equipment on the Moon and Mars.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "tsx tools/fetch-assets.ts",
    "build:data": "tsx tools/build-artifacts-json.ts",
    "palette:check": "tsx tools/palette-lock.ts",
    "validate": "tsx tools/palette-lock.ts && tsx tools/validate-data.ts --strict",
    "validate:entries": "node tools/validate-entries.mjs",
    "references": "tsx tools/build-references.ts",
    "validate:dev": "tsx tools/validate-data.ts --dev",
    "solve": "tsx tools/solve-levels.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}

