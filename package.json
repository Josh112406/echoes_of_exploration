{
  "name": "echoes-of-exploration",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Echoes of Exploration: The NASA Signal Archive — Educational browser game about NASA equipment on the Moon, Mars, and deep space.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
