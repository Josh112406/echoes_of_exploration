{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/echoes/mission-schema.json",
  "title": "Echoes of Exploration mission dataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "reviewed_on", "records"],
  "properties": {
    "schema_version": {"type":"string"},
    "dataset_id": {"const":"echoes-of-exploration-missions"},
    "reviewed_on": {"type":"string","format":"date"},
    "scope": {"type":"string","minLength":20},
    "records": {
      "type":"array",
      "minItems":25,
      "uniqueItems":true,
      "items": {"$ref":"#/$defs/mission"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableDate": {"type":["string","null"],"format":"date"},
    "mission": {
      "type":"object",
      "required":["id","name","chapter","featured","agencies","hardware_types","destination","launch_date","arrival_date","mission_end_date","status","location_summary","objective","science_summary","story_hook","source_ids","media_page_url","status_review_required_before_release"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "name":{"type":"string","minLength":2},
        "chapter":{"enum":["moon","mars","elsewhere"]},
        "featured":{"type":"boolean"},
        "featured_encounter_id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "agencies":{"type":"array","minItems":1,"items":{"type":"string"}},
        "hardware_types":{"type":"array","minItems":1,"items":{"type":"string"}},
        "destination":{"type":"string"},
        "launch_date":{"$ref":"#/$defs/nullableDate"},
        "arrival_date":{"$ref":"#/$defs/nullableDate"},
        "mission_end_date":{"$ref":"#/$defs/nullableDate"},
        "status":{"enum":["active-primary","active-extended","passive-science","completed-surface","completed-orbit","silent-location-known","silent-location-approximate","intentionally-impacted","unintentionally-impacted","lost-or-unknown"]},
        "location_summary":{"type":"string","minLength":10},
        "objective":{"type":"string","minLength":10},
        "science_summary":{"type":"string","minLength":20},
        "story_hook":{"type":"string","minLength":10},
        "source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
        "media_page_url":{"type":"string","format":"uri"},
        "status_review_required_before_release":{"type":"boolean"}
      },
      "additionalProperties": false,
      "allOf":[
        {"if":{"properties":{"featured":{"const":true}}},"then":{"required":["featured_encounter_id"]}}
      ]
    }
  }
}
